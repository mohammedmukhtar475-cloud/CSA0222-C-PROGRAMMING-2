#include <stdio.h>

int main(void) {
    double price = 500.0;
    int qty = 3;
    int senior = 1; // 1 for senior, 0 otherwise

    // Corrected expression with proper grouping and floating-point literals
    double gross = price * qty;
    double discount = senior ? (gross * 0.15) : 0.0;
    double gst = gross * 0.05;
    double total = gross - discount + gst;
    
    double net = (total > 1000.0) ? (total - 50.0) : total;

    printf("Gross: %.2f, Total: %.2f, Net: %.2f\n", gross, total, net);
    return 0;
}
